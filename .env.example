# Required: Slack bot user OAuth token for the app that posts tips.
# Get this from api.slack.com/apps -> your app -> OAuth & Permissions.
# Required bot scope: chat:write. Invite the bot to the target channel
# with `/invite @YourAppName` before the first post.
# Token format: xoxb-...
SLACK_BOT_TOKEN=

# Required: Slack channel ID that approved tips should be posted to.
# (e.g. C0B4JLW16CA). Find this in the channel's "About" tab.
SLACK_CHANNEL_ID=

# Required: site-wide access code shared internally with anyone who should
# be able to use the form at all. Anyone without this is bounced to /unlock
# and never receives the form HTML. Pick a memorable phrase, or generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(12))"
SITE_PASSWORD=

# Required: shared password for the /admin review portal (a separate gate
# on top of SITE_PASSWORD that only reviewers should know).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=

# Required: secret used to sign the admin session cookie.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Required in production: the public origin of the deployed app, used to
# reject cross-site form submissions. Leave blank for local development.
# Example: https://tips.example.com
ALLOWED_ORIGIN=

# Optional. Defaults shown.
APPROVED_PURGE_DAYS=30
DENIED_PURGE_DAYS=7
DB_PATH=tips.db

# Optional: enables pre-submission content moderation via the Claude API.
# When ANTHROPIC_API_KEY is set, every submission is classified by Claude
# before reaching the HR queue. Hate speech, harassment, sexual content,
# threats, doxxing, and illegal-activity advocacy are auto-rejected; less
# clear-cut content (self-harm references, self-identifying language,
# workplace grievances) is saved with a flag the reviewer sees. Failing
# open by design — if the API errors, submissions pass through unchanged.
# Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Optional: enables the admin password-reset feature. When RESEND_API_KEY
# is set, a "Reset password" link appears on /admin/login. Clicking it
# emails a one-time link (valid for 1 hour) to RESET_EMAIL_TO.
#
# Sign up at resend.com (free tier covers this). Sending from the default
# onboarding@resend.dev requires no DNS setup. If you verify a domain in
# Resend, set RESET_EMAIL_FROM to something like
# "Anonymous Tips <noreply@yourdomain.com>".
RESEND_API_KEY=
RESET_EMAIL_TO=kimberly.rascon@realworklabs.com
RESET_EMAIL_FROM=Mental Health Tips <onboarding@resend.dev>
